{
  "manifest_version": 3,
  "name": "Nudges — Maya Drift Detector",
  "version": "1.0.0",
  "description": "Catches silent browser drift and nudges you back to your active commitment",
  "permissions": [
    "tabs",
    "notifications",
    "alarms",
    "idle",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://my-day-lovat.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
